# Environment variables for Playwright tests
# Copy this file to .env and fill in the actual values

# DECEASED_NAME (Deceased name) for test authentication
DECEASED_NAME=your_test_deceased_name_here

# HEIR_SSN (Personal identification number) for test authentication
HEIR_SSN=your_test_ssn_here
# HEIR2_SSN, HEIR3_SSN and HEIR4_SSN: other heirs of the same estate, who make
# the Privat skifte, Bo av liten verdi and Offentlig skifte choices in step 4
HEIR2_SSN=your_test_ssn_here
HEIR3_SSN=your_test_ssn_here
HEIR4_SSN=your_test_ssn_here
# HEIR5_SSN: an heir of the same estate whose language in Altinn Profile is
# nynorsk, who checks that the correspondence reaches them in nynorsk
HEIR5_SSN=your_test_ssn_here

# HEIR_NAME (Heir name) for test authentication
HEIR_NAME=your_test_heir_name_here
HEIR2_NAME=your_test_heir_name_here
HEIR3_NAME=your_test_heir_name_here
HEIR4_NAME=your_test_heir_name_here
